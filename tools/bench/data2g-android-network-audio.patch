diff --git a/native/app/tcp_audio.cpp b/native/app/tcp_audio.cpp
new file mode 100644
index 0000000..3ff76e7
--- /dev/null
+++ b/native/app/tcp_audio.cpp
@@ -0,0 +1,130 @@
+#include "app/tcp_audio.hpp"
+
+#include <QByteArray>
+#include <QElapsedTimer>
+#include <QMetaObject>
+#include <QTcpSocket>
+#include <QTimer>
+#include <QtEndian>
+
+#include <bit>
+#include <cmath>
+#include <utility>
+#include <vector>
+
+#include "audio/fifo.hpp"
+
+namespace data2g::app {
+
+class TcpAudio::Worker : public QObject {
+public:
+    Worker(std::string host, int port, audio::CaptureFifo& cap, audio::PlaybackFifo& play,
+           Report report, std::shared_ptr<Shared> state)
+        : host_(std::move(host)), port_(port), cap_(cap), play_(play),
+          report_(std::move(report)), state_(std::move(state)) {}
+
+    void start() {
+        socket_ = new QTcpSocket(this);
+        socket_->setReadBufferSize(LIMIT);
+        timer_ = new QTimer(this);
+        timer_->setTimerType(Qt::PreciseTimer);
+        deadline_ = new QTimer(this);
+        deadline_->setSingleShot(true);
+        connect(deadline_, &QTimer::timeout, this, [this] { fail("connect timed out"); });
+        connect(socket_, &QTcpSocket::connected, this, [this] {
+            socket_->setSocketOption(QAbstractSocket::LowDelayOption, 1);
+            deadline_->stop();
+            state_->connected = true;
+            last_rx_.start();
+            timer_->start(32);  // 256 samples at 8 kHz, including continuous silence
+        });
+        connect(socket_, &QTcpSocket::readyRead, this, [this] { receive(); });
+        connect(socket_, &QTcpSocket::disconnected, this, [this] { fail("peer disconnected"); });
+        connect(socket_, &QTcpSocket::errorOccurred, this, [this](auto) { fail(socket_->errorString().toStdString()); });
+        connect(socket_, &QTcpSocket::bytesWritten, this, [this](qint64 n) { state_->sent += n; });
+        connect(timer_, &QTimer::timeout, this, [this] { transmit(); });
+        deadline_->start(15000);
+        socket_->connectToHost(QString::fromStdString(host_), port_);
+    }
+
+    void stop() {
+        stopping_ = true;
+        state_->connected = false;
+        if (timer_) timer_->stop();
+        if (deadline_) deadline_->stop();
+        if (socket_) socket_->abort();
+    }
+
+private:
+    void fail(const std::string& why) {
+        if (stopping_ || state_->failed.exchange(true)) return;
+        stop();
+        cap_.close();
+        if (report_) report_("TCP test audio: " + why);
+    }
+    void receive() {
+        if (stopping_) return;
+        const QByteArray bytes = socket_->readAll();
+        if (!bytes.isEmpty()) last_rx_.restart();
+        state_->received += bytes.size();
+        pending_.append(bytes);
+        if (pending_.size() > LIMIT + 3) return fail("receive queue exceeded one second");
+        const qsizetype count = pending_.size() / 4;
+        std::vector<double> samples;
+        samples.reserve(count);
+        for (qsizetype i = 0; i < count; ++i) {
+            const float sample = std::bit_cast<float>(qFromLittleEndian<quint32>(pending_.constData() + i * 4));
+            if (!std::isfinite(sample)) return fail("non-finite float32 sample; check peer audio format");
+            samples.push_back(sample);
+        }
+        pending_.remove(0, count * 4);  // preserve fragmented float bytes
+        cap_.write(samples);
+        if (cap_.dropped()) fail("capture FIFO overflowed; samples lost");
+    }
+    void transmit() {
+        if (stopping_) return;
+        if (last_rx_.elapsed() > 10000) return fail("no incoming audio for ten seconds");
+        if (socket_->bytesToWrite() + 1024 > LIMIT) return fail("send queue exceeded one second");
+        std::vector<float> samples(256);
+        play_.pull(samples);
+        QByteArray bytes(1024, '\0');
+        for (int i = 0; i < 256; ++i)
+            qToLittleEndian<quint32>(std::bit_cast<quint32>(samples[i]), bytes.data() + i * 4);
+        if (socket_->write(bytes) != bytes.size()) fail("socket rejected audio bytes");
+    }
+    static constexpr qsizetype LIMIT = 32768;
+    std::string host_;
+    int port_;
+    audio::CaptureFifo& cap_;
+    audio::PlaybackFifo& play_;
+    Report report_;
+    std::shared_ptr<Shared> state_;
+    QTcpSocket* socket_ = nullptr;
+    QTimer *timer_ = nullptr, *deadline_ = nullptr;
+    QElapsedTimer last_rx_;
+    QByteArray pending_;
+    bool stopping_ = false;
+};
+
+TcpAudio::TcpAudio(std::string host, int port, audio::CaptureFifo& cap, audio::PlaybackFifo& play, Report report)
+    : state_(std::make_shared<Shared>()),
+      worker_(new Worker(std::move(host), port, cap, play, std::move(report), state_)) {
+    play.set_output_latency(0.032);
+    worker_->moveToThread(&thread_);
+    QObject::connect(&thread_, &QThread::started, worker_, [w = worker_] { w->start(); });
+    QObject::connect(&thread_, &QThread::finished, worker_, &QObject::deleteLater);
+    thread_.setObjectName(QStringLiteral("d2g-tcp-audio"));
+    thread_.start();
+}
+TcpAudio::~TcpAudio() { stop(); }
+void TcpAudio::stop() {
+    if (!worker_) return;
+    QMetaObject::invokeMethod(worker_, [w = worker_] { w->stop(); }, Qt::BlockingQueuedConnection);
+    thread_.quit();
+    thread_.wait();
+    worker_ = nullptr;
+}
+bool TcpAudio::failed() const { return state_->failed; }
+TcpAudio::Stats TcpAudio::stats() const { return {state_->connected, state_->received, state_->sent}; }
+
+}  // namespace data2g::app
