--- /dev/null
+++ b/native/tests/test_tcp_audio.cpp
@@ -0,0 +1,75 @@
+// Raw network audio preserves float bytes across TCP fragments; peer loss
+// wakes capture and fails explicitly, and stopping joins the worker promptly.
+#include <QCoreApplication>
+#include <QElapsedTimer>
+#include <QHostAddress>
+#include <QTcpServer>
+#include <QTcpSocket>
+#include <QThread>
+#include <QtEndian>
+#include <atomic>
+#include <bit>
+#include <functional>
+#include <vector>
+
+#include "app/tcp_audio.hpp"
+#include "audio/fifo.hpp"
+#include "check.hpp"
+
+using namespace data2g;
+
+bool until(const std::function<bool()>& condition, int ms = 4000) {
+    QElapsedTimer timer;
+    timer.start();
+    while (!condition() && timer.elapsed() < ms) {
+        QCoreApplication::processEvents();
+        QThread::msleep(2);
+    }
+    return condition();
+}
+
+int main(int argc, char** argv) {
+    QCoreApplication app(argc, argv);
+    QTcpServer server;
+    check::is_true(server.listen(QHostAddress::LocalHost, 0), "listen");
+    audio::CaptureFifo capture(8000);
+    audio::PlaybackFifo playback(8000, 0);
+    std::vector<double> samples;
+    QByteArray bytes;
+    for (int i = 0; i < 512; ++i) {
+        const float v = (i - 256) / 1024.0f;
+        samples.push_back(v);
+        char encoded[4];
+        qToLittleEndian<quint32>(std::bit_cast<quint32>(v), encoded);
+        bytes.append(encoded, 4);
+    }
+    playback.write(samples);
+    std::atomic<bool> reported{false};
+    app::TcpAudio audio("127.0.0.1", server.serverPort(), capture, playback,
+                        [&](const auto&) { reported = true; });
+    if (!until([&] { return server.hasPendingConnections(); })) return 1;
+    auto* peer = server.nextPendingConnection();
+    QByteArray received;
+    QObject::connect(peer, &QTcpSocket::readyRead, [&] { received += peer->readAll(); });
+    for (qsizetype i = 0; i < bytes.size(); i += 37) {
+        peer->write(bytes.mid(i, 37));
+        peer->flush();
+        QCoreApplication::processEvents();
+    }
+    check::is_true(until([&] { return capture.backlog() >= samples.size() && received.size() >= bytes.size(); }), "both directions move");
+    if (capture.backlog() >= samples.size()) {
+        const auto got = capture.read(samples.size());
+        check::is_true(got && *got == samples, "fragmented float samples exact");
+    }
+    check::is_true(received.first(bytes.size()) == bytes, "transmit float bytes exact");
+    check::equal(audio.stats().received, static_cast<std::uint64_t>(bytes.size()), "receive counter");
+    peer->disconnectFromHost();
+    check::is_true(until([&] { return audio.failed() && reported; }), "remote disconnect fails");
+    check::is_true(!capture.read(1), "disconnect wakes capture with EOF");
+    QElapsedTimer stopping;
+    stopping.start();
+    audio.stop();
+    audio.stop();
+    check::is_true(stopping.elapsed() < 1000, "stop is prompt and idempotent");
+    return check::failures ? 1 : 0;
+}
