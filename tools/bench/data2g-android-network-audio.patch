+// Explicit no-radio test audio: raw little-endian float32 mono at 8 kHz,
+// over one outbound TCP connection. No framing or sample conversion.
+#pragma once
+
+#include <QThread>
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace data2g::audio { class CaptureFifo; class PlaybackFifo; }
+namespace data2g::app {
+
+class TcpAudio {
+public:
+    struct Stats { bool connected; std::uint64_t received, sent; };
+    using Report = std::function<void(const std::string&)>;
+    TcpAudio(std::string host, int port, audio::CaptureFifo&, audio::PlaybackFifo&, Report);
+    ~TcpAudio();
+    void stop();
+    bool failed() const;
+    Stats stats() const;
+
+private:
+    struct Shared {
+        std::atomic<bool> failed{false}, connected{false};
+        std::atomic<std::uint64_t> received{0}, sent{0};
+    };
+    class Worker;
+    std::shared_ptr<Shared> state_;
+    QThread thread_;
+    Worker* worker_;
+};
+}  // namespace data2g::app
